#!/usr/bin/env python3
"""Portable launcher for the user-level Loop Memory installation.

The launcher is intentionally independent of its own location.  It always
loads the shared runtime from ``~/.local/share/loop-memory`` so an invocation
from an arbitrary project directory cannot accidentally import a checkout.
"""

from pathlib import Path
import runpy
import sys


def main() -> int:
    install_root = Path.home() / ".local" / "share" / "loop-memory"
    scripts_root = install_root / "scripts"
    entrypoint = scripts_root / "loop_memory.py"
    if not entrypoint.is_file():
        sys.stderr.write("loop-memory: shared installation is unavailable\n")
        return 4
    root_text = str(install_root)
    if root_text not in sys.path:
        sys.path.insert(0, root_text)
    # runpy preserves the CLI's one-JSON-object contract and argv handling.
    runpy.run_path(str(entrypoint), run_name="__main__")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
